{
  "name": "@osu-recommender/server",
  "version": "0.1.0",
  "description": "Backend API for osu! beatmap recommender",
  "main": "dist/index.js",
  "types": "dist/root-router.d.ts",
  "exports": {
    ".": {
      "types": "./dist/root-router.d.ts",
      "default": "./dist/index.js"
    },
    "./root-router": {
      "types": "./dist/root-router.d.ts",
      "default": "./dist/root-router.js"
    }
  },
  "scripts": {
    "dev": "bun run --watch src/index.ts",
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:ui": "vitest --ui",
    "start": "bun dist/index.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@duckdb/node-api": "^1.4.4-r.1",
    "@trpc/client": "11.10.0",
    "@trpc/react-query": "11.10.0",
    "@trpc/server": "11.10.0",
    "cors": "^2.8.6",
    "express": "^4.18.2",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.21",
    "@types/node": "^20.10.0",
    "@types/supertest": "^6.0.2",
    "@vitest/coverage-v8": "^4.0.18",
    "@vitest/ui": "^4.0.18",
    "supertest": "^6.3.3",
    "ts-node": "^10.9.2",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3",
    "vitest": "^4.0.18"
  }
}
