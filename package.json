{
  "name": "osu-recommender",
  "version": "1.0.0",
  "description": "osu! Beatmap Recommender System - Full-stack ETL pipeline and web application",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "etl:full": "cd packages/etl && python run_pipeline.py --full",
    "etl:bronze": "cd packages/etl && python run_pipeline.py --phase bronze",
    "etl:silver": "cd packages/etl && python run_pipeline.py --phase silver",
    "etl:gold": "cd packages/etl && python run_pipeline.py --phase gold",
    "etl:dry-run": "cd packages/etl && python run_pipeline.py --full --dry-run",
    "backend:dev": "cd packages/server && npm run dev",
    "backend:build": "cd packages/server && npm run build",
    "backend:start": "cd packages/server && npm start",
    "backend:test": "cd packages/server && npm test",
    "frontend:dev": "cd packages/app && npm run dev",
    "frontend:build": "cd packages/app && npm run build",
    "frontend:preview": "cd packages/app && npm run preview",
    "frontend:test": "cd packages/app && npm test",
    "test:python": "pytest packages/etl/tests/ -v 2>/dev/null || pytest tests/ -v",
    "test:backend": "cd packages/server && npm test",
    "test:frontend": "cd packages/app && npm test",
    "test:all": "npm run test:python && npm run test:backend && npm run test:frontend",
    "pipeline:full": "npm run etl:full && npm run backend:build && npm run frontend:build",
    "dev": "concurrently \"npm run backend:dev\" \"npm run frontend:dev\"",
    "build": "turbo run build",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "clean": "turbo run clean && rm -rf packages/server/dist packages/app/dist",
    "reset": "npm run clean && rm -rf venv packages/server/node_modules packages/app/node_modules"
  },
  "keywords": ["osu", "recommender", "etl", "duckdb", "react"],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "concurrently": "^8.2.2",
    "turbo": "^2.0.0"
  },
  "packageManager": "npm@10.0.0"
}
